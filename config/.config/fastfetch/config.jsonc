{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "sixel",
        "source": "~/.config/fastfetch/logos/Arch-fastfetch-red.png",
        "width": 32,
        "height": 20,
        "preserveAspectRatio": true,
        "color": { "1": "38;2;255;45;57", "2": "38;2;255;91;100" },
        "padding": { "top": 1, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "key": { "width": 17 },
        "color": { "keys": "38;2;255;45;57", "title": "38;2;255;45;57", "output": "38;2;244;244;245" },
        "percent": { "type": ["num", "num-color"], "color": { "green": "green", "yellow": "yellow", "red": "red" } },
        "size": { "binaryPrefix": "iec", "ndigits": 1 },
        "temp": { "unit": "C", "ndigits": 0 }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
        },
        "break",

        // ── Sistema ──────────────────────────────────────────
        { "type": "custom", "format": "{#38;2;255;45;57}╭─ 󰣇  Sistema" },
        { "type": "os",       "key": "│ ├  OS",        "keyColor": "38;2;255;45;57", "format": "{pretty-name} {arch}" },
        { "type": "kernel",   "key": "│ ├  Kernel",    "keyColor": "38;2;255;45;57", "format": "{release}" },
        { "type": "packages", "key": "│ ├ 󰏗 Pacotes",   "keyColor": "38;2;255;45;57" },
        { "type": "wm",       "key": "│ ├ 󱗃 WM",        "keyColor": "38;2;255;45;57", "format": "{pretty-name} {version}" },
        { "type": "shell",    "key": "│ ├  Shell",     "keyColor": "38;2;255;45;57", "format": "{pretty-name} {version}" },
        { "type": "terminal", "key": "│ ├  Terminal",  "keyColor": "38;2;255;45;57", "format": "{pretty-name} {version}" },
        { "type": "uptime",   "key": "│ ├ 󱫐 Ligado há",  "keyColor": "38;2;255;45;57", "format": "{?days}{days}d {?}{hours}h {minutes}min" },
        { "type": "disk",     "key": "│ ├ 󱦟 Instalado", "keyColor": "38;2;255;45;57", "folders": "/", "format": "há {days} dias" },
        { "type": "custom", "format": "{#38;2;255;45;57}╰─" },
        "break",

        // ── Hardware ─────────────────────────────────────────
        { "type": "custom", "format": "{#38;2;255;91;100}╭─ 󰌢  Hardware" },
        { "type": "host",    "key": "│ ├ 󰌢 Modelo",  "keyColor": "38;2;255;91;100", "format": "{name}" },
        { "type": "cpu",     "key": "│ ├  CPU",     "keyColor": "38;2;255;91;100", "format": "{name} ({cores-physical}C/{cores-logical}T) @ {freq-max}", "temp": true },
        { "type": "gpu",     "key": "│ ├ 󰊴 GPU",     "keyColor": "38;2;255;91;100", "format": "{name} · {type}" },
        { "type": "memory",  "key": "│ ├ 󰍛 Memória", "keyColor": "38;2;255;91;100", "format": "{used} / {total} ({percentage})" },
        { "type": "swap",    "key": "│ ├ 󰓡 Swap",    "keyColor": "38;2;255;91;100", "format": "{used} / {total} ({percentage})" },
        { "type": "disk",    "key": "│ ├ 󰋊 Disco",   "keyColor": "38;2;255;91;100", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage}) · {filesystem}" },
        { "type": "display", "key": "│ ├ 󰍹 Tela",    "keyColor": "38;2;255;91;100", "format": "{width}x{height} @ {refresh-rate} Hz · {inch}\"" },
        { "type": "custom", "format": "{#38;2;255;91;100}╰─" },
        "break",

        // ── Energia e rede ───────────────────────────────────
        { "type": "custom", "format": "{#38;2;255;133;140}╭─ 󰂄  Energia e rede" },
        { "type": "battery", "key": "│ ├ 󰁹 Bateria",  "keyColor": "38;2;255;133;140", "format": "{capacity} · {status}" },
        { "type": "wifi",    "key": "│ ├ 󰖩 Wi-Fi",    "keyColor": "38;2;255;133;140", "format": "{ssid} · {signal-quality}" },
        { "type": "localip", "key": "│ ├ 󰩟 IP {ifname}", "keyColor": "38;2;255;133;140", "showIpv4": true, "showIpv6": false, "defaultRouteOnly": false, "format": "{ipv4}" },
        { "type": "custom", "format": "{#38;2;255;133;140}╰─" },
        "break",

        { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
    ]
}
