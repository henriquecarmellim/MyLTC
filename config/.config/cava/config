# MyLTC — cava (visualizador de áudio em barras vermelhas, como no vídeo)
[general]
framerate = 60
bars = 0
bar_width = 2
bar_spacing = 1

[input]
method = pipewire
source = auto

[output]
method = noncurses

[color]
gradient = 1
gradient_count = 4
gradient_color_1 = '#43141a'
gradient_color_2 = '#ff858c'
gradient_color_3 = '#ff5b64'
gradient_color_4 = '#ff2d39'

[smoothing]
noise_reduction = 77
